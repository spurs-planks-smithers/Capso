TURNSTILE_SECRET_NEXTSHOT_FEEDBACK=
INTAKE_SECRET_NEXTSHOT_FEEDBACK=
# Separate bucket-only signature updater source credential.
CLOUDFLARE_R2_TOKEN_NEXTSHOT_SIGNATURES=
