// nextshot.dev on Cloudflare Workers. Deploy with site/deploy.sh. It stages a
// copy of this file under build/site-stages/ with its assets folder changed and
// one variable added, SIZES (the byte size of each video). See docs/site.md.
{
  "name": "nextshot-site",
  "account_id": "2afca1b8aab7ec4024bdb7cb2fec47c0",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../build/site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // The private bucket that holds every released DMG and zip, and latest.json.
  // scripts/release.sh writes to it. Nothing in it is public except through
  // this Worker.
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "nextshot-releases" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nextshot-downloads",
      "database_id": "87e6330a-0812-49eb-974d-9516aaef04c2"
    }
  ],
  "routes": [
    { "pattern": "nextshot.dev", "custom_domain": true },
    { "pattern": "www.nextshot.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
