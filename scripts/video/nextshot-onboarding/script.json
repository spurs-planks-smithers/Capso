  "scenes": [
    {
      "id": "hook",
      "lead": 1.25,
      "tail": 0.2,
      "lines": [
        {
          "id": "built",
          "text": "So, you and AI just built a lemonade stand.",
          "pause": 0,
          "tempo": 1.2,
          "direction": "Relaxed and inviting, with a small smile. Keep it moving."
        }
      ]
    },
    {
      "id": "problem",
      "lead": 0.05,
      "tail": 0.35,
      "lines": [
        {
          "id": "flawed",
          "text": "But AI's first draft is far from perfect. Small things are wrong everywhere.",
          "captions": [
            "But AI's first draft is far from perfect.",
            "Small things are wrong everywhere."
          ],
          "pause": 0.2,
          "tempo": 1.14,
          "take": 1,
          "direction": "Smooth and even, one flowing thought at the same pace as the line before. A natural, unhurried beat after 'perfect'.",
          "max_gap": 0.25
        },
        {
          "id": "loop",
          "text": "So you screenshot. Crop. Paste. Prompt.",
          "pause": 0.12,
          "take": 2,
          "max_gap": 0.25,
          "direction": "Punchy and quick: four crisp beats, rising frustration. Say 'you' clearly.",
          "tempo": 1.22
        },
        {
          "id": "explain",
          "text": "But with so many fixes, big and small, on so many screens, why is it so taxing to gather and give AI all those visual directions?",
          "captions": [
            "But with so many fixes, big and small,",
            "on so many screens,",
            "why is it so taxing to gather",
            "and give AI all those visual directions?"
          ],
          "pause": 0.15,
          "direction": "Building frustration, quick. Lean on 'so taxing', then a clear question at the end.",
          "tempo": 1.28
        },
        {
          "id": "again",
          "text": "Page after page. Prompt after prompt. Paste after paste. Into AI eternity.",
          "captions": [
            "Page after page. Prompt after prompt.",
            "Paste after paste. Into AI eternity."
          ],
          "pause": 0.4,
          "direction": "Weary and wry, three even beats, a little faster.",
          "tempo": 1.26
        },
        {
          "id": "ask",
          "text": "Why can't I gather all my feedback in one round, and give it to AI in one prompt?",
          "captions": [
            "Why can't I gather all my feedback",
            "in one round, and give it to AI in one prompt?"
          ],
          "pause": 0,
          "tempo": 1.0,
          "max_gap": 0.3,
          "direction": "Slow down. A sincere, deliberate question: the key question of the whole video. Land 'one round' and 'one prompt' with weight."
        }
      ]
    },
    {
      "id": "turn",
      "lead": 0.15,
      "tail": 0.2,
      "lines": [
        {
          "id": "meet",
          "text": "Now you can. Introducing Nextshot.",
          "pause": 0,
          "tempo": 1.18,
          "direction": "A bright reset: confident, then proud and warm on 'Introducing Nextshot'."
        }
      ]
    },
    {
      "id": "how",
      "lead": 0.5,
      "tail": 0.2,
      "lines": [
        {
          "id": "g",
          "text": "Hit Option Shift F. Capture the area for visual feedback.",
          "captions": [
            "Hit Option Shift F.",
            "Capture the area for visual feedback."
          ],
          "pause": 0.2,
          "tempo": 1.14,
          "max_gap": 0.25,
          "direction": "Calm, human, and instructive. Say 'Option, Shift, F' as three clear keys, with a tiny beat between them."
        },
        {
          "id": "h",
          "text": "Click to drop a red dot on each issue. Then just say what should change.",
          "captions": [
            "Click to drop a red dot on each issue.",
            "Then just say what should change."
          ],
          "pause": 0,
          "direction": "Calm and instructive.",
          "tempo": 1.25,
          "take": 2
        }
      ]
    },
    {
      "id": "session",
      "lead": 0.1,
      "tail": 0.2,
      "lines": [
        {
          "id": "i",
          "text": "Grab the next screen, and the next. One round holds it all.",
          "pause": 0,
          "direction": "Light and quick, then confident. Stress 'one round'.",
          "captions": [
            "Grab the next screen, and the next.",
            "One round holds it all."
          ],
          "tempo": 1.3
        }
      ]
    },
    {
      "id": "handoff",
      "lead": 0.5,
      "tail": 1.1,
      "lines": [
        {
          "id": "handoff",
          "text": "One click hands AI the whole round.",
          "captions": [
            "One click hands AI the whole round."
          ],
          "pause": 0.35,
          "direction": "Deliberate and clear: this is the key point. Stress 'whole round'.",
          "tempo": 1.25
        },
        {
          "id": "paste",
          "text": "Any agent. One prompt, built the way AI reads best: numbered dots, clear notes, exact spots, a plan first.",
          "captions": [
            "Any agent. One prompt,",
            "built the way AI reads best:",
            "numbered dots, clear notes,",
            "exact spots, a plan first."
          ],
          "pause": 0,
          "direction": "Clear and confident. Stress 'the way AI reads best', then list the four parts crisply.",
          "tempo": 1.26,
          "take": 2
        }
      ]
    },
    {
      "id": "close",
      "lead": 0.3,
      "tail": 1.5,
      "lines": [
        {
          "id": "tagline",
          "text": "Nextshot. Show AI what you mean.",
          "captions": [
