  "scenes": [
    {
      "id": "hook",
      "lead": 1.0,
      "tail": 0.3,
      "lines": [
        {
          "id": "built",
          "text": "So, you and AI just built a lemonade stand.",
          "pause": 0,
          "tempo": 1.14,
          "direction": "Relaxed and inviting, with a small smile. Keep it moving."
        }
      ]
    },
    {
      "id": "problem",
      "lead": 0.05,
      "tail": 0.3,
      "lines": [
        {
          "id": "flawed",
          "text": "But AI output is far from perfect. Small things are wrong everywhere.",
          "captions": [
            "But AI output is far from perfect.",
            "Small things are wrong everywhere."
          ],
          "pause": 0.2,
          "tempo": 1.14,
          "take": 2,
          "direction": "Let the problem land on 'far from perfect', then keep moving briskly."
        },
        {
          "id": "loop",
          "text": "So you screenshot. Crop. Paste. Prompt.",
          "pause": 0.12,
          "take": 2,
          "max_gap": 0.25,
          "direction": "Punchy and quick: four crisp beats, rising frustration. Say 'you' clearly.",
          "tempo": 1.15
        },
        {
          "id": "explain",
          "text": "But with so many fixes, big and small, on so many screens, how do you give AI every direction?",
          "captions": [
            "But with so many fixes, big and small,",
            "on so many screens,",
            "how do you give AI every direction?"
          ],
          "pause": 0.15,
          "direction": "Building frustration, quick, then a clear question at the end.",
          "tempo": 1.15
        },
        {
          "id": "again",
          "text": "Page after page. Prompt after prompt. Into AI eternity.",
          "captions": [
            "Page after page. Prompt after prompt.",
            "Into AI eternity."
          ],
          "pause": 0.15,
          "direction": "Weary and wry, a little faster.",
          "tempo": 1.18
        },
        {
          "id": "ask",
          "text": "Why can't I gather all my feedback in one round, and give it to AI in one prompt?",
          "captions": [
            "Why can't I gather all my feedback",
            "in one round, and give it to AI in one prompt?"
          ],
          "pause": 0,
          "tempo": 1.0,
          "max_gap": 0.3,
          "direction": "Slow down. A sincere, deliberate question, the key question of the whole video. Stress 'one round' and 'one prompt'."
        }
      ]
    },
    {
      "id": "turn",
      "lead": 0.15,
      "tail": 0.25,
      "lines": [
        {
          "id": "meet",
          "text": "Now you can. Introducing Nextshot.",
          "pause": 0,
          "tempo": 1.15,
          "direction": "A bright reset: confident, then proud and warm on 'Introducing Nextshot'."
        }
      ]
    },
    {
      "id": "how",
      "lead": 0.1,
      "tail": 0.45,
      "lines": [
        {
          "id": "g",
          "text": "Hit Option Shift F. Grab the area you want to give feedback on.",
          "captions": [
            "Hit Option Shift F.",
            "Grab the area you want to give feedback on."
          ],
          "pause": 0.2,
          "tempo": 1.0,
          "max_gap": 0.25,
          "direction": "Calm, human, and instructive. Say 'Option, Shift, F' as three clear keys, with a tiny beat between them."
        },
        {
          "id": "h",
          "text": "Hit C, then click to drop a dot on each issue. Then say what should change.",
          "captions": [
            "Hit C, then click to drop a dot on each issue.",
            "Then say what should change."
          ],
          "pause": 0.2,
          "direction": "Calm and instructive. Say 'C' as the letter C."
        }
      ]
    },
    {
      "id": "session",
      "lead": 0.1,
      "tail": 0.35,
      "lines": [
        {
          "id": "i",
          "text": "Then grab the next screen, and the next.",
          "pause": 0.2,
          "direction": "Light and quick."
        },
        {
          "id": "j",
          "text": "Circles, boxes, arrows, notes. One round holds it all.",
          "captions": [
            "Circles, boxes, arrows, notes.",
            "One round holds it all."
          ],
          "pause": 0.2,
          "direction": "Confident. Stress 'one round'."
        }
      ]
    },
    {
      "id": "handoff",
      "lead": 0.8,
      "tail": 2.4,
      "lines": [
        {
          "id": "handoff",
          "text": "One click, one paste, and AI gets the whole round. Every screen, every dot, every note.",
          "captions": [
            "One click, one paste,",
            "and AI gets the whole round.",
            "Every screen, every dot, every note."
          ],
          "pause": 0.3,
          "direction": "Deliberate and clear: this is the key point. Stress 'whole round'."
        },
        {
          "id": "paste",
          "text": "Any AI agent gets one prompt, built the way AI reads: numbered dots, a note on each dot, exact pixels, and a plan before it edits.",
          "captions": [
            "Any AI agent gets one prompt,",
            "built the way AI reads:",
            "numbered dots, a note on each dot,",
            "exact pixels, and a plan before it edits."
          ],
          "pause": 0,
          "direction": "Clear and confident. Stress 'built the way AI reads', then list the four parts crisply."
        }
      ]
    },
    {
      "id": "close",
      "lead": 0.3,
      "tail": 2.4,
      "lines": [
        {
          "id": "tagline",
          "text": "Nextshot. Show AI what you mean.",
          "captions": [
            "Nextshot.",
            "Show AI what you mean."
          ],
          "pause": 0,
          "direction": "Say 'Nextshot' once, warm and proud. Then upbeat and crisp, with a smile."
        }
      ]
    }
