{
  "manifest_version": 3,
  "name": "Nextshot Pilot",
  "version": "0.1.0",
  "description": "Private browser-only feedback pilot. Capture, mark, and export locally. No app or account required.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "pilot-background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Nextshot Pilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/nextshot-16.png",
      "24": "icons/nextshot-24.png",
      "32": "icons/nextshot-32.png"
    }
  },
  "commands": {
    "capture": {
      "description": "Select an area for Nextshot feedback",
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' data: blob:;"
  },
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/nextshot-16.png",
    "32": "icons/nextshot-32.png",
    "48": "icons/nextshot-48.png",
    "128": "icons/nextshot-128.png"
  }
}
