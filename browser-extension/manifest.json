{
  "manifest_version": 3,
  "name": "Nextshot Dev",
  "version": "0.1.0",
  "description": "Capture browser feedback with exact element context. Works with or without Nextshot.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "nativeMessaging",
    "tabCapture",
    "webRequest",
    "downloads",
    "clipboardWrite",
    "offscreen",
    "identity"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Nextshot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/nextshot-16.png",
      "24": "icons/nextshot-24.png",
      "32": "icons/nextshot-32.png"
    }
  },
  "commands": {
    "capture": {
      "description": "Select an area for Nextshot feedback",
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      }
    },
    "rolling-round": {
      "description": "Review Rolling Round",
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      }
    }
  },
  "icons": {
    "16": "icons/nextshot-16.png",
    "32": "icons/nextshot-32.png",
    "48": "icons/nextshot-48.png",
    "128": "icons/nextshot-128.png"
  }
}
