{
  "manifest_version": 3,
  "name": "Nextshot Dev",
  "version": "0.1.0",
  "description": "Capture browser feedback with exact element context. Works with or without Nextshot.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "nativeMessaging",
    "tabCapture",
    "webRequest",
    "downloads",
    "clipboardWrite",
    "offscreen"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Nextshot",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture": {
      "description": "Capture browser feedback",
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      }
    }
  }
}
